# Copie para .env (ignorado pelo git). Sem AGENT_RUNTIME=github-actions o app funciona como antes.
AGENT_RUNTIME=github-actions
GITHUB_REPO=dono/repositorio
# Credencial do GitHub: prefira `gh auth login` (o backend usa `gh auth token`).
# Alternativa: GH_TOKEN com permissão de Issues (leitura/escrita) e Actions (escrita) só neste repositório.
# GH_TOKEN=
